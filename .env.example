# Firebase Admin service account JSON (read from Render env vars — never commit real values)
FIREBASE_SERVICE_ACCOUNT=

# AI provider API keys
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Model IDs (optional — defaults are used if unset)
OPENROUTER_MODEL_1=openrouter/free
GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_CHAT_MODEL=openai/gpt-oss-20b
SYNTHESIS_MODEL=openrouter/free

# Output control
MAX_OUTPUT_TOKENS=4096
MAX_CONTINUATIONS=3

# CORS (optional, comma-separated extra origins)
EXTRA_ORIGINS=
